<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Top spacer — pushes content down proportionally -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>

    <!-- Logo & Title -->
    <LinearLayout
        android:id="@+id/container_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="24dp">

        <FrameLayout
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/bg_icon_container"
            android:elevation="4dp">
            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_logo"/>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SubLinks Client"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <!-- Content Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_login"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Tab Toggle Background -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="8dp">

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_login_method"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_tab_toggle"
                    app:tabMode="fixed"
                    app:tabGravity="fill"
                    app:tabIndicator="@drawable/bg_tab_indicator"
                    app:tabIndicatorGravity="stretch"
                    app:tabIndicatorHeight="36dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabTextColor="?android:attr/textColorPrimary"
                    app:tabSelectedTextColor="@android:color/white"
                    app:tabIndicatorColor="@android:color/transparent"
                    app:tabPaddingStart="4dp"
                    app:tabPaddingEnd="4dp"/>

            </LinearLayout>

            <!-- Browser Login Container -->
            <LinearLayout
                android:id="@+id/container_browser_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="28dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/iv_browser_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_baseline_exit_to_app"
                    app:tint="#6366F1"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_browser_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/login_browser_desc"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="24dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_browser_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/login_browser_button"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_baseline_exit_to_app"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"/>

                <!-- Polling status area -->
                <LinearLayout
                    android:id="@+id/container_polling"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone"
                    android:background="@drawable/bg_info_row"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="20dp"
                    android:layout_marginTop="16dp">

                    <ProgressBar
                        android:id="@+id/progress_polling"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:indeterminate="true"
                        style="?android:attr/progressBarStyle"/>

                    <TextView
                        android:id="@+id/tv_browser_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorPrimary"
                        android:gravity="center"/>

                    <TextView
                        android:id="@+id/tv_browser_countdown"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textSize="13sp"
                        android:textColor="#6366F1"
                        android:textStyle="bold"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_browser_cancel"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/login_browser_cancel"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_marginTop="16dp"
                        app:cornerRadius="12dp"
                        app:strokeColor="#EF4444"
                        android:textColor="#EF4444"/>

                </LinearLayout>

            </LinearLayout>

            <!-- Password Login Container -->
            <LinearLayout
                android:id="@+id/container_password_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:paddingTop="24dp"
                android:paddingBottom="28dp"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_username"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_username"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/login_password"
                    android:layout_marginBottom="20dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/login_button"
                    android:textSize="15sp"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_baseline_vpn_lock"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"/>

            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Sync Progress Area (shown after login success) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_sync"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="24dp"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <ProgressBar
                android:id="@+id/progress_sync"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyle"/>

            <TextView
                android:id="@+id/tv_sync_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimary"
                android:gravity="center"
                android:text="@string/syncing_subscriptions"/>

            <TextView
                android:id="@+id/tv_sync_detail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"/>

</LinearLayout>
